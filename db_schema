CREATE TABLE cart (
    cid INT AUTO_INCREMENT PRIMARY KEY,
    uid INT,
    pid INT,
    quantity INT
);


CREATE TABLE orders (
    oid INT AUTO_INCREMENT PRIMARY KEY,
    uid INT,
    pid INT,
    quantity INT,
    total INT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);